# Create a free Sanity project at https://www.sanity.io/manage (or run `npx sanity@latest init`)
# and fill these in.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# A token with at least "Editor" (read/write) permissions.
# Create one at https://www.sanity.io/manage -> your project -> API -> Tokens.
# Used by: the seed script (writes content), and next-sanity's Live Content API
# (so the front end can live-update on both published AND draft content).
SANITY_API_READ_TOKEN=
